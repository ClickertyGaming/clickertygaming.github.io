---
import { type CollectionEntry, getCollection } from "astro:content";
import { Fragment } from "astro/jsx-runtime";
import '../../styles/style.css';
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogPost from '../../components/BlogPost.astro';
const posts = (await getCollection('blog')).sort(
    (a, b) => ('' + b.id).localeCompare(a.id)
);
---
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="Clickerty">
        <meta name="description" content="Clickerty's personal website.">
        <meta name="keywords" content="webdev, personal, blog">
        <link rel="alternate" href="rss.xml" type="application/rss+xml" title="Clickerty">
        <title>Blog</title>
    </head>
    <body>
        <Header />
        <div style="padding: 0 20px;  min-height: calc(var(--viewport-size) - 178px);">
            <h1>Blog</h1>
            <hr>
            <div>
                {
                    posts.map((post) => (
                        <BlogPost
                            title={post.data.title}
                            author={post.data.author}
                            id={post.id}
                            important={post.data.important}
                        />
                    ))
                }
            </div>
        </div>
        <Footer />
    </body>
</html>
---
import { type CollectionEntry, getCollection, render } from 'astro:content';

const { title, author, tags, id, important } = Astro.props;
import '../styles/style.css';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogPost from '../components/BlogPost.astro';
let url_array = id.split('/');
let url_str = url_array[2] + "/" + url_array[1] + "/" + url_array[0];
let important_str = "";
if (important == true) {important_str = " | Important"};
---
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="Clickerty">
        <meta name="description" content="Clickerty's personal website.">
        <meta name="keywords" content="webdev, personal, blog">
        <link rel="alternate" href="rss.xml" type="application/rss+xml" title="Clickerty">
        <title>{title}</title>
    </head>
    <body>
        <Header />
        <div style="padding: 0 20px;  min-height: calc(var(--viewport-size) - 178px);">
            <p><a href="/blog">{"<- Back"}</a></p>
            <h1>{title}</h1>
            <p>{author} | {url_str}{important_str}</p>
            <p>- {tags}</p>
            <hr>
            <div>
                <slot />
            </div>
        </div>
        <Footer />
    </body>
</html>

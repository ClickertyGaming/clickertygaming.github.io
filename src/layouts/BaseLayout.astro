---
const { title } = Astro.props;
---
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{title}</title>
        <style>
            :root {
                --viewport-size: 100vh;
            }
            html, body {
                margin: 0;
                padding: 0;
                height: var(--viewport-size);
                min-height: max-content;
                font-family: "Roboto", sans-serif;
            }
            .header, .footer {
                z-index: 1;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-left: 1rem;
                padding-right: 1rem;
                padding-bottom: 0;
                padding-top: 0;
                left: 0;
                right: 0;
                background-color: white;
                border-style: solid;
                border-color: black;
                margin: 0;
                height: 50px;
            }
            .header {
                top: 0;
                border-width: 0 0 3px 0;
            }
            .footer {
                position: static;
                display: flex;
                align-items: center;
                bottom: 0px;
                border-width: 3px 0 0 0;
                margin: 0;
            }
        </style>
    </head>
    <body>
        <div class="header">
            <div>
                <p><a href="/">Home</a></p>
            </div>
            <div>
                <p><a href="/404">404</a> | <a href="/help">Help</a></p>
            </div>
        </div>
        <div style="z-index: 0; min-height: calc(var(--viewport-size) - 106px); margin-left: 50px; margin-right: 50px; margin-top: 0; margin-bottom: 0; padding: 0; text-align: center; display: flex; flex-direction: column; align-items: center;">
           <slot /> 
        </div>
        <div class="footer">
            <div>
                <p>© Clickerty 2026</p>
            </div>
            <div style="display: flex; flex-direction: row; justify-content: right; align-items: center;">
                <a href="https://github.com/ClickertyGaming"><img src="src/images/GitHub_Invertocat_Black_Clearspace.svg" width="42"></a>
                <p>//</p>
                <a href="https://www.youtube.com/@clickerty3"><img src="src/images/yt_icon_almostblack_digital.png" width="48"></a>
                <p>//</p>
                <a href="https://x.com/clickerty3"><img src="src/images/twitter-logo-shape-svgrepo-com.svg" width="32" style="padding-left: 5px; padding-right: 5px;"></a>
                <p>//</p>
                <a href="https://bsky.app/profile/clickerty.bsky.social"><img src="src/images/bluesky_media_kit_logo_transparent_4.svg" height="24" style="padding-left: 10px; padding-right: 10px;"></a>
                <p>//</p>
                <a href="https://tumblr.com/clickerty"><img src="src/images/Tumblr_Logos_2018.03.06_t Icon Black.png" height="24" style="padding-left: 10px; padding-right: 10px;"></a>
                <p>//</p>
                <a href="https://clickerty.newgrounds.com"><img src="src/images/newgrounds_icon_black.png" width="36" style="padding-left: 5px; padding-right: 5px;"></a>
                <p>||</p>
            </div>
        </div>
    </body>
</html>
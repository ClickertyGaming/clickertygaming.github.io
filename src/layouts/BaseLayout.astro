---
const { title } = Astro.props;
import '../styles/style.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="Clickerty">
        <meta name="description" content="Clickerty's personal website.">
        <meta name="keywords" content="webdev, personal, blog">
        <link rel="alternate" href="rss.xml" type="application/rss+xml" title="Clickerty">
        <title>{title}</title>
    </head>
    <body>
        <Header />
        <div style="z-index: 0; min-height: calc(var(--viewport-size) - 157px); min-width:340px; margin-top: 0; margin-bottom: 0; padding: 0; text-align: center; display: flex; flex-direction: column; align-items: center;">
           <slot /> 
        </div>
        <Footer />
    </body>
</html>
---
const { title, author, description } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Theme from '../components/Theme.astro';
---
<html>
    <head>
        <Head title={title} author={author} description={description} />
    </head>
    <body>
        <Header />
        <div style="z-index: 0; min-height: calc(100vh - 208px); min-width:300px; margin-top: 0; margin-bottom: 0; padding: 0; text-align: center; display: flex; flex-direction: column; align-items: center;">
           <slot /> 
        </div>
        <Footer />
    </body>
</html>